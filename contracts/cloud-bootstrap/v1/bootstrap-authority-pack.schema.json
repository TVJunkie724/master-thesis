{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/cloud-bootstrap/v1/bootstrap-authority-pack.schema.json",
  "title": "Bootstrap authority pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "provider",
    "status",
    "validation_level",
    "requires_supervised_live_validation",
    "target_modes",
    "scope_summary",
    "permission_groups",
    "credential_cleanup",
    "limitations",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "bootstrap-authority-pack.v1"},
    "contract_id": {
      "enum": [
        "bootstrap.aws.admin-v1",
        "bootstrap.azure.admin-v1",
        "bootstrap.azure.admin-v2",
        "bootstrap.gcp.admin-v1"
      ]
    },
    "provider": {"enum": ["aws", "azure", "gcp"]},
    "status": {"const": "frozen_offline_contract"},
    "validation_level": {"const": "offline_pre_e2e"},
    "requires_supervised_live_validation": {"const": true},
    "target_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["account", "subscription", "existing_project", "organization"]}
    },
    "scope_summary": {"type": "string", "minLength": 1},
    "permission_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "permissions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "scope": {"type": "string", "minLength": 1},
          "permissions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "credential_cleanup": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "aws"}}},
      "then": {
        "properties": {
          "contract_id": {"const": "bootstrap.aws.admin-v1"},
          "target_modes": {"const": ["account"]}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "azure"}}},
      "then": {
        "properties": {
          "contract_id": {
            "enum": ["bootstrap.azure.admin-v1", "bootstrap.azure.admin-v2"]
          },
          "target_modes": {"const": ["subscription"]}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "gcp"}}},
      "then": {
        "properties": {
          "contract_id": {"const": "bootstrap.gcp.admin-v1"},
          "target_modes": {"const": ["existing_project", "organization"]}
        }
      }
    }
  ]
}
