{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/deployment-access/v1/deployment-access.schema.json",
  "title": "Deployment access snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "twin_id",
    "deployment_id",
    "generated_at",
    "availability",
    "reason_code",
    "surfaces"
  ],
  "properties": {
    "schema_version": {"const": "deployment-access.v1"},
    "twin_id": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "availability": {"enum": ["available", "unsupported"]},
    "reason_code": {
      "enum": [null, "unsupported_historical_profile"]
    },
    "surfaces": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/surface"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"availability": {"const": "available"}}},
      "then": {
        "properties": {
          "reason_code": {"type": "null"},
          "surfaces": {
            "minItems": 2,
            "maxItems": 2,
            "contains": {"properties": {"layer": {"const": "l4"}}},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"availability": {"const": "unsupported"}}},
      "then": {
        "properties": {
          "reason_code": {"const": "unsupported_historical_profile"},
          "surfaces": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "provider",
        "service_id",
        "display_name",
        "url",
        "auth",
        "readiness",
        "capabilities",
        "limitations"
      ],
      "properties": {
        "layer": {"enum": ["l4", "l5"]},
        "provider": {"enum": ["aws", "azure", "gcp"]},
        "service_id": {
          "enum": [
            "aws_iot_twinmaker",
            "azure_digital_twins",
            "gcp_twin_explorer",
            "aws_managed_grafana",
            "azure_managed_grafana",
            "gcp_grafana_oss"
          ]
        },
        "display_name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "principal_label", "credential_action"],
          "properties": {
            "mode": {
              "enum": [
                "aws_identity_center",
                "azure_entra",
                "gcp_iap",
                "generated_viewer"
              ]
            },
            "principal_label": {"type": "string", "minLength": 1},
            "credential_action": {"enum": ["none", "rotate"]}
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource",
            "access_binding",
            "content",
            "data_probe",
            "browser_sign_in"
          ],
          "properties": {
            "resource": {"enum": ["ready", "failed", "pending"]},
            "access_binding": {"enum": ["ready", "blocked", "pending"]},
            "content": {"enum": ["ready", "failed", "pending"]},
            "data_probe": {"enum": ["ready", "failed", "pending"]},
            "browser_sign_in": {"enum": ["unverified", "verified", "failed"]}
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
