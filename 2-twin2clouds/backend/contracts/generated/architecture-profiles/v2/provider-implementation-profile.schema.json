{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/architecture-profiles/v2/provider-implementation-profile.schema.json",
  "title": "ProviderImplementationProfile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation_profile_id",
    "implementation_profile_version",
    "architecture_profile_ref",
    "provider",
    "lifecycle_status",
    "region_policy_ref",
    "permission_set_ref",
    "supported",
    "component_mappings",
    "edge_mappings",
    "capability_claims",
    "unsupported_reasons",
    "compatibility",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "provider-implementation-profile.v2"
    },
    "implementation_profile_id": {
      "$ref": "semantic-registry.schema.json#/$defs/stable_id"
    },
    "implementation_profile_version": {
      "$ref": "semantic-registry.schema.json#/$defs/version"
    },
    "architecture_profile_ref": {
      "$ref": "semantic-registry.schema.json#/$defs/pinned_ref"
    },
    "provider": {
      "$ref": "semantic-registry.schema.json#/$defs/provider"
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "region_policy_ref": {
      "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
    },
    "permission_set_ref": {
      "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
    },
    "supported": {
      "type": "boolean"
    },
    "component_mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/component_mapping"
      }
    },
    "edge_mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/edge_mapping"
      }
    },
    "capability_claims": {
      "$ref": "#/$defs/capability_claims"
    },
    "unsupported_reasons": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/unsupported_reason"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "content_digest": {
      "$ref": "semantic-registry.schema.json#/$defs/digest"
    }
  },
  "$defs": {
    "stable_id_array": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "semantic-registry.schema.json#/$defs/stable_id"
      }
    },
    "non_empty_stable_id_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "semantic-registry.schema.json#/$defs/stable_id"
      }
    },
    "component_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "deployment_component_candidates",
        "required_capability_ids",
        "provided_capability_ids",
        "service_model_refs",
        "formula_refs",
        "supported_region_ids",
        "deployment_specification_component_ids",
        "deployment_specification_slot_ids"
      ],
      "properties": {
        "component_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "deployment_component_candidates": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "required_capability_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "provided_capability_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "service_model_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "formula_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "supported_region_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "deployment_specification_component_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "deployment_specification_slot_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        }
      }
    },
    "edge_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "edge_implementation_id",
        "source_deployment_component_ids",
        "destination_deployment_component_ids",
        "mechanism",
        "catalog_input_port_id",
        "catalog_output_port_id",
        "transfer_route_class",
        "cost_owner_ids"
      ],
      "properties": {
        "edge_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "edge_implementation_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "source_deployment_component_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "destination_deployment_component_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "mechanism": {
          "enum": [
            "provider_native_trigger",
            "source_owned_transition_runtime",
            "typed_synchronous_api",
            "cross_provider_adapter"
          ]
        },
        "catalog_input_port_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "catalog_output_port_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "transfer_route_class": {
          "enum": [
            "same_provider_same_region",
            "same_provider_cross_region",
            "cross_provider"
          ]
        },
        "cost_owner_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        }
      }
    },
    "capability_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_capability_ids",
        "provided_capability_ids",
        "extra_capability_ids",
        "missing_capability_ids",
        "evidence_refs"
      ],
      "properties": {
        "required_capability_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "provided_capability_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "extra_capability_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "missing_capability_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        }
      }
    },
    "unsupported_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "message"
      ],
      "properties": {
        "reason_code": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible_catalog_versions",
        "compatible_resolver_versions",
        "compatible_runtime_versions",
        "compatible_deployment_specification_versions"
      ],
      "properties": {
        "compatible_catalog_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
          }
        },
        "compatible_resolver_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/version"
          }
        },
        "compatible_runtime_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/version"
          }
        },
        "compatible_deployment_specification_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "resolved-deployment-specification.v2"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "supported": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "unsupported_reasons": {
            "maxItems": 0
          },
          "capability_claims": {
            "properties": {
              "missing_capability_ids": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unsupported_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
