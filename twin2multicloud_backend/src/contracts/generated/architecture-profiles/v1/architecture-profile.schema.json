{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/architecture-profiles/v1/architecture-profile.schema.json",
  "title": "ArchitectureProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "lifecycle_status",
    "display_name",
    "description",
    "workload_contract_ref",
    "optimization_bundle",
    "optimization_slot_ids",
    "responsibilities",
    "components",
    "edges",
    "extension_slots",
    "functional_completeness_rules",
    "graph_policy",
    "compatibility",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-profile.v1"
    },
    "profile_id": {
      "$ref": "semantic-registry.schema.json#/$defs/stable_id"
    },
    "profile_version": {
      "$ref": "semantic-registry.schema.json#/$defs/version"
    },
    "lifecycle_status": {
      "$ref": "#/$defs/lifecycle_status"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "workload_contract_ref": {
      "$ref": "semantic-registry.schema.json#/$defs/pinned_ref"
    },
    "optimization_bundle": {
      "$ref": "semantic-registry.schema.json#/$defs/optimization_bundle"
    },
    "optimization_slot_ids": {
      "$ref": "#/$defs/non_empty_stable_id_array"
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/responsibility"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/logical_component"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/logical_edge"
      }
    },
    "extension_slots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/extension_slot"
      }
    },
    "functional_completeness_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/functional_completeness_rule"
      }
    },
    "graph_policy": {
      "$ref": "#/$defs/graph_policy"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "content_digest": {
      "$ref": "semantic-registry.schema.json#/$defs/digest"
    }
  },
  "$defs": {
    "lifecycle_status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "stable_id_array": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "semantic-registry.schema.json#/$defs/stable_id"
      }
    },
    "non_empty_stable_id_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "semantic-registry.schema.json#/$defs/stable_id"
      }
    },
    "functional_completeness_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "evidence",
        "required"
      ],
      "properties": {
        "capability_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required": {
          "const": true
        }
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibility_id",
        "display_name",
        "required",
        "capability_requirements",
        "workload_field_refs",
        "cost_category_ids",
        "logical_component_ids",
        "evaluation_order"
      ],
      "properties": {
        "responsibility_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "required": {
          "const": true
        },
        "capability_requirements": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "workload_field_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "cost_category_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "logical_component_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "evaluation_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "logical_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "responsibility_id",
        "component_kind",
        "required",
        "required_capability_ids",
        "input_port_ids",
        "output_port_ids",
        "extension_slot_ids",
        "cost_owner_ids",
        "observability_contract_id"
      ],
      "properties": {
        "component_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "responsibility_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "component_kind": {
          "enum": [
            "ingress",
            "processor",
            "storage",
            "twin_state",
            "visualization"
          ]
        },
        "required": {
          "const": true
        },
        "required_capability_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "input_port_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "output_port_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "extension_slot_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "cost_owner_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "observability_contract_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        }
      }
    },
    "delivery_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "timeout_policy",
        "retry_policy",
        "dead_letter_policy",
        "idempotency",
        "ordering",
        "replay"
      ],
      "properties": {
        "mode": {
          "enum": [
            "synchronous",
            "asynchronous"
          ]
        },
        "timeout_policy": {
          "enum": [
            "bounded",
            "not_applicable"
          ]
        },
        "retry_policy": {
          "enum": [
            "bounded_backoff",
            "provider_managed_bounded",
            "none"
          ]
        },
        "dead_letter_policy": {
          "enum": [
            "required",
            "provider_managed",
            "not_applicable"
          ]
        },
        "idempotency": {
          "enum": [
            "required",
            "consumer_deduplicated",
            "not_required"
          ]
        },
        "ordering": {
          "enum": [
            "per_entity",
            "best_effort",
            "not_required"
          ]
        },
        "replay": {
          "enum": [
            "required",
            "bounded",
            "not_supported"
          ]
        }
      }
    },
    "trust_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication",
        "authorization",
        "transport"
      ],
      "properties": {
        "authentication": {
          "enum": [
            "workload_identity",
            "provider_service_identity"
          ]
        },
        "authorization": {
          "enum": [
            "least_privilege_capability_set"
          ]
        },
        "transport": {
          "enum": [
            "tls",
            "provider_internal_encrypted"
          ]
        }
      }
    },
    "observability_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation",
        "metrics",
        "bounded_error_contract"
      ],
      "properties": {
        "correlation": {
          "const": "required"
        },
        "metrics": {
          "const": "required"
        },
        "bounded_error_contract": {
          "const": "required"
        }
      }
    },
    "logical_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_component_id",
        "source_port_id",
        "destination_component_id",
        "destination_port_id",
        "edge_contract_id",
        "edge_contract_version",
        "required",
        "delivery_requirements",
        "trust_requirements",
        "observability_requirements",
        "transfer_workload_ref",
        "cost_owner_ids"
      ],
      "properties": {
        "edge_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "source_component_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "source_port_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "destination_component_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "destination_port_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "edge_contract_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "edge_contract_version": {
          "$ref": "semantic-registry.schema.json#/$defs/version"
        },
        "required": {
          "const": true
        },
        "delivery_requirements": {
          "$ref": "#/$defs/delivery_requirements"
        },
        "trust_requirements": {
          "$ref": "#/$defs/trust_requirements"
        },
        "observability_requirements": {
          "$ref": "#/$defs/observability_requirements"
        },
        "transfer_workload_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "cost_owner_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        }
      }
    },
    "extension_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "slot_version",
        "component_id",
        "input_contract_ref",
        "output_contract_ref",
        "configuration_contract_ref",
        "artifact_policy_id"
      ],
      "properties": {
        "slot_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "slot_version": {
          "$ref": "semantic-registry.schema.json#/$defs/version"
        },
        "component_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "input_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "output_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "configuration_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "artifact_policy_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        }
      }
    },
    "graph_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_policy",
        "allowed_cycle_ids",
        "optional_components",
        "user_topology_editable"
      ],
      "properties": {
        "cycle_policy": {
          "enum": [
            "acyclic",
            "allowlisted"
          ]
        },
        "allowed_cycle_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "optional_components": {
          "type": "array",
          "maxItems": 0
        },
        "user_topology_editable": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cycle_policy": {
                "const": "acyclic"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_cycle_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_contract_versions",
        "provider_implementation_schema_versions",
        "catalog_schema_versions",
        "resolved_architecture_schema_versions"
      ],
      "properties": {
        "supported_contract_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "provider_implementation_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "provider-implementation-profile.v1"
          }
        },
        "catalog_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "deployment-component-catalog.v1"
          }
        },
        "resolved_architecture_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "resolved-twin-architecture.v1"
          }
        }
      }
    }
  }
}
