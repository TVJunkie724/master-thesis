{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/architecture-profiles/v1/deployment-component-catalog.schema.json",
  "title": "DeploymentComponentCatalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "lifecycle_status",
    "components",
    "edge_implementations",
    "package_artifacts",
    "compatibility",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "deployment-component-catalog.v1"
    },
    "catalog_id": {
      "$ref": "semantic-registry.schema.json#/$defs/stable_id"
    },
    "catalog_version": {
      "$ref": "semantic-registry.schema.json#/$defs/version"
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "edge_implementations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/edge_implementation"
      }
    },
    "package_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/package_artifact"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/catalog_compatibility"
    },
    "content_digest": {
      "$ref": "semantic-registry.schema.json#/$defs/digest"
    }
  },
  "$defs": {
    "stable_id_array": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "semantic-registry.schema.json#/$defs/stable_id"
      }
    },
    "non_empty_stable_id_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "semantic-registry.schema.json#/$defs/stable_id"
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_component_id",
        "component_version",
        "provider",
        "logical_component_ids",
        "decision_implementation_ids",
        "service_id",
        "service_ids",
        "component_kind",
        "package_artifact_ref",
        "terraform_binding",
        "runtime_contract",
        "configuration_schema_ref",
        "input_ports",
        "output_ports",
        "required_permission_capabilities",
        "pricing_model_refs",
        "formula_refs",
        "deployment_specification_bindings",
        "extension_slot_refs",
        "error_contract_ref",
        "observability_contract_ref",
        "cleanup_contract_ref",
        "compatibility"
      ],
      "properties": {
        "deployment_component_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "component_version": {
          "$ref": "semantic-registry.schema.json#/$defs/version"
        },
        "provider": {
          "$ref": "semantic-registry.schema.json#/$defs/provider"
        },
        "logical_component_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "decision_implementation_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "service_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "service_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "component_kind": {
          "enum": [
            "managed_service",
            "serverless_function",
            "storage_service",
            "twin_service",
            "visualization_service",
            "adapter"
          ]
        },
        "package_artifact_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "terraform_binding": {
          "$ref": "#/$defs/terraform_binding"
        },
        "runtime_contract": {
          "$ref": "#/$defs/runtime_contract"
        },
        "configuration_schema_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "input_ports": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "output_ports": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "required_permission_capabilities": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "pricing_model_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "formula_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "deployment_specification_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/deployment_binding"
          }
        },
        "extension_slot_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
          }
        },
        "error_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "observability_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "cleanup_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "compatibility": {
          "$ref": "#/$defs/component_compatibility"
        }
      }
    },
    "terraform_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_addresses",
        "module_addresses",
        "allowed_input_variable_ids",
        "input_bindings",
        "outputs",
        "dependency_keys"
      ],
      "properties": {
        "resource_addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
            "maxLength": 180
          }
        },
        "module_addresses": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^module\\.[a-z0-9_]+$",
            "maxLength": 180
          }
        },
        "allowed_input_variable_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "input_bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/terraform_input"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/terraform_output"
          }
        },
        "dependency_keys": {
          "$ref": "#/$defs/stable_id_array"
        }
      }
    },
    "terraform_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_id",
        "terraform_output",
        "sensitive"
      ],
      "properties": {
        "output_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "terraform_output": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 160
        },
        "sensitive": {
          "type": "boolean"
        }
      }
    },
    "terraform_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "terraform_variable",
        "sensitive"
      ],
      "properties": {
        "input_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "terraform_variable": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 160
        },
        "sensitive": {
          "type": "boolean"
        }
      }
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_runtime_id",
        "platform_handler_adapter_id",
        "timeout_seconds_min",
        "timeout_seconds_max",
        "memory_mb_min",
        "memory_mb_max",
        "trigger_adapter_id",
        "package_layout_id",
        "user_override_allowed"
      ],
      "properties": {
        "provider_runtime_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "platform_handler_adapter_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "timeout_seconds_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "timeout_seconds_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "memory_mb_min": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "memory_mb_max": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "trigger_adapter_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "package_layout_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "user_override_allowed": {
          "const": false
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_id",
        "schema_ref",
        "envelope_ref",
        "value_type",
        "sensitivity",
        "cardinality",
        "producer_consumer_phase",
        "resolution_stage",
        "compatibility_version"
      ],
      "properties": {
        "port_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "schema_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "envelope_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "value_type": {
          "enum": [
            "json_document",
            "json_array",
            "string",
            "integer",
            "decimal",
            "boolean",
            "reference"
          ]
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "sensitive_reference"
          ]
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "producer_consumer_phase": {
          "enum": [
            "resolution",
            "deployment",
            "runtime",
            "cleanup"
          ]
        },
        "resolution_stage": {
          "enum": [
            "catalog",
            "optimizer",
            "deployer_output"
          ]
        },
        "compatibility_version": {
          "$ref": "semantic-registry.schema.json#/$defs/version"
        }
      }
    },
    "deployment_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification_schema_version",
        "component_id",
        "slot_id"
      ],
      "properties": {
        "specification_schema_version": {
          "const": "resolved-deployment-specification.v1"
        },
        "component_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "slot_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        }
      }
    },
    "component_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_profile_versions",
        "provider_profile_versions",
        "deployment_specification_versions"
      ],
      "properties": {
        "architecture_profile_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
          }
        },
        "provider_profile_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
          }
        },
        "deployment_specification_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "resolved-deployment-specification.v1"
          }
        }
      }
    },
    "edge_implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_implementation_id",
        "edge_implementation_version",
        "provider",
        "decision_edge_ids",
        "logical_edge_ids",
        "mechanism",
        "source_component_ids",
        "destination_component_ids",
        "source_output_port_id",
        "destination_input_port_id",
        "terraform_binding",
        "transfer_route_class",
        "payload_contract_ref",
        "delivery_requirements",
        "trust_contract_ref",
        "pricing_model_refs",
        "formula_refs",
        "required_permission_capabilities",
        "glue_component_ids",
        "error_contract_ref",
        "observability_contract_ref",
        "compatibility"
      ],
      "properties": {
        "edge_implementation_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "edge_implementation_version": {
          "$ref": "semantic-registry.schema.json#/$defs/version"
        },
        "provider": {
          "oneOf": [
            {
              "$ref": "semantic-registry.schema.json#/$defs/provider"
            },
            {
              "const": "platform"
            }
          ]
        },
        "decision_edge_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "logical_edge_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "mechanism": {
          "enum": [
            "provider_native_trigger",
            "source_owned_transition_runtime",
            "typed_synchronous_api",
            "cross_provider_adapter"
          ]
        },
        "source_component_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "destination_component_ids": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "source_output_port_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "destination_input_port_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "terraform_binding": {
          "$ref": "#/$defs/edge_terraform_binding"
        },
        "transfer_route_class": {
          "enum": [
            "same_provider_same_region",
            "same_provider_cross_region",
            "cross_provider"
          ]
        },
        "payload_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "delivery_requirements": {
          "$ref": "#/$defs/delivery_requirements"
        },
        "trust_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "pricing_model_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "formula_refs": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "required_permission_capabilities": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "glue_component_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "error_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "observability_contract_ref": {
          "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
        },
        "compatibility": {
          "$ref": "#/$defs/component_compatibility"
        }
      }
    },
    "edge_terraform_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_output_id",
        "destination_input_id",
        "dependency_keys"
      ],
      "properties": {
        "source_output_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "destination_input_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "dependency_keys": {
          "$ref": "#/$defs/stable_id_array"
        }
      }
    },
    "delivery_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "timeout_policy",
        "retry_policy",
        "dead_letter_policy",
        "idempotency",
        "ordering",
        "replay"
      ],
      "properties": {
        "mode": {
          "enum": [
            "synchronous",
            "asynchronous"
          ]
        },
        "timeout_policy": {
          "enum": [
            "bounded",
            "not_applicable"
          ]
        },
        "retry_policy": {
          "enum": [
            "bounded_backoff",
            "provider_managed_bounded",
            "none"
          ]
        },
        "dead_letter_policy": {
          "enum": [
            "required",
            "provider_managed",
            "not_applicable"
          ]
        },
        "idempotency": {
          "enum": [
            "required",
            "consumer_deduplicated",
            "not_required"
          ]
        },
        "ordering": {
          "enum": [
            "per_entity",
            "best_effort",
            "not_required"
          ]
        },
        "replay": {
          "enum": [
            "required",
            "bounded",
            "not_supported"
          ]
        }
      }
    },
    "package_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version",
        "decision_implementation_ids",
        "repository_source_path",
        "platform_handler",
        "digest_policy",
        "source_digest",
        "included_paths",
        "excluded_paths",
        "dependency_artifact_refs",
        "builder_adapter_id",
        "supported_runtimes",
        "user_source_policy",
        "compatibility"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "artifact_version": {
          "$ref": "semantic-registry.schema.json#/$defs/version"
        },
        "decision_implementation_ids": {
          "$ref": "#/$defs/stable_id_array"
        },
        "repository_source_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$",
          "maxLength": 300
        },
        "platform_handler": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "digest_policy": {
          "const": "sha256.canonical-source.v1"
        },
        "source_digest": {
          "$ref": "semantic-registry.schema.json#/$defs/digest"
        },
        "included_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "excluded_paths": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "dependency_artifact_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/versioned_ref"
          }
        },
        "builder_adapter_id": {
          "$ref": "semantic-registry.schema.json#/$defs/stable_id"
        },
        "supported_runtimes": {
          "$ref": "#/$defs/non_empty_stable_id_array"
        },
        "user_source_policy": {
          "enum": [
            "platform_only",
            "validated_extension_slot"
          ]
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component_versions",
            "builder_versions"
          ],
          "properties": {
            "component_versions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "semantic-registry.schema.json#/$defs/version"
              }
            },
            "builder_versions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "semantic-registry.schema.json#/$defs/version"
              }
            }
          }
        }
      }
    },
    "catalog_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_profile_schema_versions",
        "provider_profile_schema_versions",
        "resolver_versions",
        "deployer_runtime_versions",
        "deployment_specification_versions"
      ],
      "properties": {
        "architecture_profile_schema_versions": {
          "type": "array",
          "const": [
            "architecture-profile.v1"
          ]
        },
        "provider_profile_schema_versions": {
          "type": "array",
          "const": [
            "provider-implementation-profile.v1"
          ]
        },
        "resolver_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/version"
          }
        },
        "deployer_runtime_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "semantic-registry.schema.json#/$defs/version"
          }
        },
        "deployment_specification_versions": {
          "type": "array",
          "const": [
            "resolved-deployment-specification.v1"
          ]
        }
      }
    }
  }
}
