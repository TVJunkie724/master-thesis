{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/cloud-bootstrap/v1/cloud-bootstrap-guide.schema.json",
  "title": "Cloud bootstrap guide v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guide_digest",
    "provider",
    "execution_mode",
    "target",
    "bootstrap_authority_pack",
    "generated_deployment_pack",
    "api_baseline",
    "credential_fields",
    "credential_origins",
    "preparation_steps",
    "known_blockers",
    "legacy_fallback_available"
  ],
  "properties": {
    "schema_version": {"const": "cloud-bootstrap-guide.v1"},
    "guide_digest": {"$ref": "#/$defs/digest"},
    "provider": {"enum": ["aws", "azure", "gcp"]},
    "execution_mode": {
      "enum": ["disabled", "deterministic_fake", "supervised_live"]
    },
    "target": {"$ref": "#/$defs/target"},
    "bootstrap_authority_pack": {"$ref": "#/$defs/packReference"},
    "generated_deployment_pack": {"$ref": "#/$defs/packReference"},
    "api_baseline": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/apiBaseline"}
      ]
    },
    "credential_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "input_type", "required", "redaction_rule"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "label": {"type": "string", "minLength": 1},
          "input_type": {"enum": ["identifier", "secret", "json"]},
          "required": {"type": "boolean"},
          "redaction_rule": {"enum": ["identifier", "secret", "private_key_document"]}
        }
      }
    },
    "credential_origins": {
      "const": ["dedicated_disposable", "existing_user_owned"]
    },
    "preparation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/instruction"}
    },
    "known_blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "legacy_fallback_available": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "aws"}}},
      "then": {
        "properties": {
          "target": {"properties": {"provider": {"const": "aws"}}},
          "api_baseline": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "azure"}}},
      "then": {
        "properties": {
          "target": {"properties": {"provider": {"const": "azure"}}},
          "api_baseline": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"const": "gcp"}}},
      "then": {
        "properties": {
          "target": {
            "properties": {
              "provider": {"const": "gcp"},
              "mode": {"const": "existing_project"}
            }
          },
          "api_baseline": {"$ref": "#/$defs/apiBaseline"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "account_id", "region"],
          "properties": {
            "provider": {"const": "aws"},
            "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
            "region": {"type": "string", "minLength": 1},
            "session_expires_at": {"type": "string", "format": "date-time"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "tenant_id", "subscription_id", "region"],
          "properties": {
            "provider": {"const": "azure"},
            "tenant_id": {"type": "string", "minLength": 1},
            "subscription_id": {"type": "string", "minLength": 1},
            "region": {"type": "string", "minLength": 1},
            "bootstrap_credential_key_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "mode", "project_id", "region"],
          "properties": {
            "provider": {"const": "gcp"},
            "mode": {"const": "existing_project"},
            "project_id": {"type": "string", "minLength": 1},
            "region": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "mode", "bootstrap_project_id", "organization_id", "billing_account_id", "region"],
          "properties": {
            "provider": {"const": "gcp"},
            "mode": {"const": "organization"},
            "bootstrap_project_id": {"type": "string", "minLength": 1},
            "organization_id": {"type": "string", "minLength": 1},
            "folder_id": {"type": "string", "minLength": 1},
            "billing_account_id": {"type": "string", "minLength": 1},
            "region": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "packReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "scope_summary", "limitations", "artifact_url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "scope_summary": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "artifact_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "apiBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "services",
        "retain_enabled",
        "mutation_summary",
        "limitations",
        "artifact_url"
      ],
      "properties": {
        "id": {"const": "gcp.phase8-api-baseline.v1"},
        "digest": {"$ref": "#/$defs/digest"},
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.googleapis\\.com$"
          }
        },
        "retain_enabled": {"const": true},
        "mutation_summary": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "artifact_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "expected_outcome", "official_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "expected_outcome": {"type": "string", "minLength": 1},
        "official_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "title", "message", "blocking", "action"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "severity": {"enum": ["info", "warning", "error"]},
        "title": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "action": {"type": "string", "minLength": 1},
        "remediation_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    }
  }
}
