{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/cloud-bootstrap/v1/gcp-phase8-api-baseline.schema.json",
  "title": "GCP Phase 8 API baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "provider",
    "status",
    "profiles",
    "target_mode",
    "region",
    "owner",
    "bootstrap_prerequisite_services",
    "services",
    "retain_enabled",
    "mutation_summary",
    "limitations",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "gcp-phase8-api-baseline.v1"},
    "baseline_id": {"const": "gcp.phase8-api-baseline.v1"},
    "provider": {"const": "gcp"},
    "status": {"const": "frozen_offline_contract"},
    "profiles": {
      "const": ["five-layer-baseline@2", "six-layer-eventing@1"]
    },
    "target_mode": {"const": "existing_project"},
    "region": {"const": "europe-west1"},
    "owner": {"const": "bootstrap.gcp.admin-v3"},
    "bootstrap_prerequisite_services": {
      "const": [
        "cloudresourcemanager.googleapis.com",
        "iam.googleapis.com",
        "serviceusage.googleapis.com"
      ]
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.googleapis\\.com$"
      }
    },
    "retain_enabled": {"const": true},
    "mutation_summary": {"type": "string", "minLength": 1},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    }
  }
}
