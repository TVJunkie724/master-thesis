{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/resolved-deployment-specification/v2/schema.json",
  "title": "ResolvedDeploymentSpecification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calculation_run_id",
    "architecture_profile_ref",
    "optimization_context",
    "readiness",
    "currency",
    "fixed_dimensions",
    "component_selections",
    "bindings",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "resolved-deployment-specification.v2"
    },
    "calculation_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "architecture_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "optimization_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_decision_ref",
        "component_catalog_ref",
        "workload_ref",
        "eventing_scenario_ref",
        "formula_set_ref",
        "pricing_evidence_refs"
      ],
      "properties": {
        "service_decision_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "component_catalog_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "workload_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "eventing_scenario_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "formula_set_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "pricing_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "digest"
            ],
            "properties": {
              "provider": {
                "enum": [
                  "aws",
                  "azure",
                  "gcp"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocking_gate_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "offline_contract_fixture",
            "deployment_ready"
          ]
        },
        "blocking_gate_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          }
        }
      }
    },
    "currency": {
      "enum": [
        "USD",
        "EUR"
      ]
    },
    "fixed_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l4_inspection_sessions_per_month",
        "l4_reads_per_inspection_session",
        "visualized_numeric_metrics_per_record",
        "rollup_bucket_seconds",
        "reader_timeout_seconds",
        "reader_maximum_points",
        "storage_batch_interval_minutes",
        "storage_task_max_input_mib",
        "storage_object_max_uncompressed_mib",
        "storage_transfer_retry_horizon_hours",
        "storage_source_expiry_grace_hours",
        "azure_mover_max_device_partitions_per_task"
      ],
      "properties": {
        "l4_inspection_sessions_per_month": {
          "type": "integer",
          "const": 12
        },
        "l4_reads_per_inspection_session": {
          "type": "integer",
          "const": 20
        },
        "visualized_numeric_metrics_per_record": {
          "type": "integer",
          "const": 1
        },
        "rollup_bucket_seconds": {
          "type": "integer",
          "const": 3600
        },
        "reader_timeout_seconds": {
          "type": "integer",
          "const": 10
        },
        "reader_maximum_points": {
          "type": "integer",
          "const": 1000
        },
        "storage_batch_interval_minutes": {
          "type": "integer",
          "const": 5
        },
        "storage_task_max_input_mib": {
          "type": "integer",
          "const": 512
        },
        "storage_object_max_uncompressed_mib": {
          "type": "integer",
          "const": 64
        },
        "storage_transfer_retry_horizon_hours": {
          "type": "integer",
          "const": 24
        },
        "storage_source_expiry_grace_hours": {
          "type": "integer",
          "const": 48
        },
        "azure_mover_max_device_partitions_per_task": {
          "type": "integer",
          "const": 1000
        }
      }
    },
    "component_selections": {
      "type": "array",
      "minItems": 7,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_id",
          "architecture_assignment_id",
          "logical_component_id",
          "implementation_component_id",
          "implementation_component_digest",
          "provider",
          "region",
          "required",
          "dimensions"
        ],
        "properties": {
          "selection_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "architecture_assignment_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "logical_component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "implementation_component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "implementation_component_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "provider": {
            "enum": [
              "aws",
              "azure",
              "gcp"
            ]
          },
          "region": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "required": {
            "const": true
          },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension_id",
                "classification",
                "value",
                "unit",
                "formula_reference",
                "evidence_reference"
              ],
              "properties": {
                "dimension_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                  "maxLength": 256
                },
                "classification": {
                  "enum": [
                    "deployable_selection",
                    "capacity",
                    "usage",
                    "fixed_poc",
                    "account_scope"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "integer",
                    "number",
                    "boolean"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "formula_reference": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                  "maxLength": 256
                },
                "evidence_reference": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "terraform_target": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,127}$"
                }
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "source_kind",
          "source_ref",
          "destination_selection_id",
          "destination_input_id",
          "value_type",
          "sensitivity",
          "resolution_stage",
          "validator_id",
          "compatibility_version"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "source_kind": {
            "enum": [
              "catalog_constant",
              "deployment_dimension",
              "component_output",
              "platform_configuration",
              "extension_artifact",
              "platform_runtime_secret_reference"
            ]
          },
          "source_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "destination_selection_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "destination_input_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "value_type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "json_document"
            ]
          },
          "sensitivity": {
            "enum": [
              "public",
              "internal",
              "sensitive_reference"
            ]
          },
          "resolution_stage": {
            "enum": [
              "package",
              "preplan",
              "terraform",
              "postapply"
            ]
          },
          "validator_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 256
          },
          "compatibility_version": {
            "const": "1"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
