{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "package_id",
    "implementation_freeze_commit",
    "evaluation_cutoff",
    "observation_timestamp",
    "currency",
    "regions",
    "runtime",
    "generator",
    "historical_scenarios",
    "representative_three_provider_placements"
  ],
  "properties": {
    "$schema": {"const": "evaluation-config.schema.json"},
    "schema_version": {"const": "phase-08-profile-evaluation-config.v1"},
    "package_id": {"const": "phase-08-profile-evaluation@1"},
    "implementation_freeze_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evaluation_cutoff": {"type": "string", "format": "date"},
    "observation_timestamp": {"type": "string", "format": "date-time"},
    "currency": {"const": "USD"},
    "regions": {"$ref": "#/$defs/regions"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_platform", "container_platform", "python_version", "container_images"],
      "properties": {
        "host_platform": {"const": "darwin-arm64"},
        "container_platform": {"const": "linux-arm64"},
        "python_version": {"const": "3.11"},
        "container_images": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "digest"],
            "properties": {
              "service": {"enum": ["optimizer", "management-api", "deployer", "docs"]},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "command", "container_command"],
      "properties": {
        "id": {"const": "phase-08-profile-evaluation-generator"},
        "version": {"const": "1.0.0"},
        "command": {"type": "string", "minLength": 1},
        "container_command": {"type": "string", "minLength": 1}
      }
    },
    "historical_scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "input_path", "overrides"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^historical-[a-z-]+-v1$"},
          "input_path": {"const": "2-twin2clouds/example_input.json"},
          "overrides": {"type": "object"}
        }
      }
    },
    "representative_three_provider_placements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small", "medium", "large"],
      "properties": {
        "small": {"$ref": "#/$defs/sixAssignment"},
        "medium": {"$ref": "#/$defs/sixAssignment"},
        "large": {"$ref": "#/$defs/sixAssignment"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {"enum": ["aws", "azure", "gcp"]},
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aws", "azure", "gcp"],
      "properties": {
        "aws": {"const": "eu-central-1"},
        "azure": {"const": "westeurope"},
        "gcp": {"const": "europe-west1"}
      }
    },
    "sixAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component.ingestion",
        "component.eventing",
        "component.processing",
        "component.hot-storage",
        "component.cool-storage",
        "component.archive-storage",
        "component.twin-state",
        "component.visualization"
      ],
      "properties": {
        "component.ingestion": {"$ref": "#/$defs/provider"},
        "component.eventing": {"$ref": "#/$defs/provider"},
        "component.processing": {"$ref": "#/$defs/provider"},
        "component.hot-storage": {"$ref": "#/$defs/provider"},
        "component.cool-storage": {"$ref": "#/$defs/provider"},
        "component.archive-storage": {"$ref": "#/$defs/provider"},
        "component.twin-state": {"$ref": "#/$defs/provider"},
        "component.visualization": {"$ref": "#/$defs/provider"}
      }
    }
  }
}
