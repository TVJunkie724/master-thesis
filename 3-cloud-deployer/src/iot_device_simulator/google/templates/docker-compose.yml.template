version: '3.8'

services:
  gcp-iot-simulator:
    build: .
    container_name: gcp-iot-simulator-{{device_id}}
    volumes:
      - ./config.json:/app/config.json:ro
      - ./payloads.json:/app/payloads.json:ro
      - ./server-ca.pem:/app/server-ca.pem:ro
    restart: unless-stopped
    stdin_open: true
    tty: true
