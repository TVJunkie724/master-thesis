{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/user-function-extension/v1/extension-slot.schema.json",
  "title": "ExtensionSlot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slot_id",
    "slot_version",
    "display_name",
    "responsibility_id",
    "component_id",
    "entrypoint",
    "runtime_contract",
    "input_schema",
    "output_schema",
    "configuration_schema",
    "secret_policy",
    "dependency_policy_id",
    "resource_limits",
    "network_policy",
    "permission_capabilities",
    "error_contract_id",
    "observability_contract_id",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "user-function-extension-slot.v1"
    },
    "slot_id": {
      "$ref": "#/$defs/stable_id"
    },
    "slot_version": {
      "$ref": "#/$defs/positive_version"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "responsibility_id": {
      "$ref": "#/$defs/stable_id"
    },
    "component_id": {
      "$ref": "#/$defs/stable_id"
    },
    "entrypoint": {
      "const": "process"
    },
    "runtime_contract": {
      "$ref": "#/$defs/runtime_contract"
    },
    "input_schema": {
      "$ref": "#/$defs/json_schema_contract"
    },
    "output_schema": {
      "$ref": "#/$defs/json_schema_contract"
    },
    "configuration_schema": {
      "$ref": "#/$defs/configuration_schema_contract"
    },
    "secret_policy": {
      "const": "forbidden"
    },
    "dependency_policy_id": {
      "$ref": "#/$defs/stable_id"
    },
    "resource_limits": {
      "$ref": "#/$defs/resource_limits"
    },
    "network_policy": {
      "$ref": "#/$defs/network_policy"
    },
    "permission_capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stable_id"
      }
    },
    "error_contract_id": {
      "$ref": "#/$defs/stable_id"
    },
    "observability_contract_id": {
      "$ref": "#/$defs/stable_id"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 128
    },
    "positive_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 10
    },
    "runtime_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_ids",
        "provider_adapters"
      ],
      "properties": {
        "runtime_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "const": "python311"
          }
        },
        "provider_adapters": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/provider_adapter"
          }
        }
      }
    },
    "provider_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "adapter_id",
        "adapter_version",
        "provider_runtime"
      ],
      "properties": {
        "provider": {
          "enum": [
            "aws",
            "azure",
            "gcp"
          ]
        },
        "adapter_id": {
          "$ref": "#/$defs/stable_id"
        },
        "adapter_version": {
          "$ref": "#/$defs/positive_version"
        },
        "provider_runtime": {
          "enum": [
            "python3.11",
            "3.11",
            "python311"
          ]
        }
      }
    },
    "json_schema_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "type",
        "additionalProperties",
        "properties",
        "required"
      ],
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field_schema"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    },
    "configuration_schema_contract": {
      "allOf": [
        {
          "$ref": "#/$defs/json_schema_contract"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/configuration_field_schema"
              }
            }
          }
        }
      ]
    },
    "field_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 96
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "pattern": {
          "type": "string",
          "maxLength": 256
        },
        "user_editable": {
          "type": "boolean"
        },
        "secret": {
          "const": false
        }
      }
    },
    "configuration_field_schema": {
      "allOf": [
        {
          "$ref": "#/$defs/field_schema"
        },
        {
          "type": "object",
          "required": [
            "user_editable",
            "secret"
          ]
        }
      ]
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "memory_mb",
        "artifact_bytes",
        "source_bytes",
        "response_bytes",
        "file_count",
        "dependency_count"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 104857600
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "dependency_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egress_capability_ids"
      ],
      "properties": {
        "egress_capability_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_schema_versions",
        "provider_adapter_versions"
      ],
      "properties": {
        "artifact_schema_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "const": "user-function-artifact.v1"
          }
        },
        "provider_adapter_versions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        }
      }
    }
  }
}
