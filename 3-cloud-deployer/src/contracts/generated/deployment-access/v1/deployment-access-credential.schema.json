{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/contracts/deployment-access/v1/deployment-access-credential.schema.json",
  "title": "One-time GCP Grafana Viewer credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layer",
    "provider",
    "username",
    "password",
    "issued_at"
  ],
  "properties": {
    "schema_version": {"const": "deployment-access-credential.v1"},
    "layer": {"const": "l5"},
    "provider": {"const": "gcp"},
    "username": {"type": "string", "minLength": 1},
    "password": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
