      "ErrorResponse": {
        "description": "Standardized error response with detailed information for troubleshooting.\n\nThis schema provides structured error information that enables:\n1. Understanding what went wrong (error_code, message)\n2. Knowing exactly how to fix it (fix_suggestion)\n3. Identifying specific field issues (field_errors)\n4. Finding additional help (documentation_url)\n\nAll error responses from this API follow this schema for consistency.",
        "example": {
          "documentation_url": "/documentation/docs-formulas.html",
          "error_code": "VALIDATION_ERROR",
          "field_errors": [
            {
              "field": "numberOfDevices",
              "message": "Value must be a positive integer",
              "received_value": "-5"
            }
          ],
          "fix_suggestion": "Ensure all required fields are present and have valid values. See field_errors for details.",
          "http_status": 422,
          "message": "Request validation failed"
        },
        "properties": {
          "documentation_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URL to relevant documentation for this error or endpoint",
            "example": "/documentation/docs-overview.html",
            "title": "Documentation Url"
          },
          "error_code": {
            "description": "Machine-readable error code in SCREAMING_SNAKE_CASE format. Use this to programmatically identify error types. Common codes: VALIDATION_ERROR, INVALID_CREDENTIALS, RESOURCE_NOT_FOUND, RATE_LIMITED, INTERNAL_ERROR, CONFIGURATION_MISSING",
            "example": "VALIDATION_ERROR",
            "title": "Error Code",
            "type": "string"
          },
          "field_errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "For validation errors (422), detailed list of which fields failed and why",
            "title": "Field Errors"
          },
          "fix_suggestion": {
            "description": "Actionable instruction that explains exactly how to fix this error and retry the request successfully. Be specific about what to change.",
            "example": "Set 'numberOfDevices' to a positive integer (e.g., 100). This field represents the number of IoT devices in your deployment.",
            "title": "Fix Suggestion",
            "type": "string"
          },
          "http_status": {
            "description": "The HTTP status code associated with this error (400, 401, 403, 404, 422, 500, etc.)",
            "example": 400,
            "title": "Http Status",
            "type": "integer"
          },
          "message": {
            "description": "Human-readable description of what went wrong",
            "example": "Request validation failed: numberOfDevices must be positive",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "message",
          "fix_suggestion",
          "http_status"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
