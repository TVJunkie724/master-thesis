{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.dev/schemas/phase-08-service-bundles/package-artifact.schema.json",
  "title": "Phase 8 Complete-Service Decision Artifact",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "package_id",
    "artifact_id"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/package-artifact.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "const": "phase-08-complete-service-bundles@1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  },
  "additionalProperties": true
}
