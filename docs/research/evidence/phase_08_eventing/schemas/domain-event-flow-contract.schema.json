{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin2multicloud.local/schemas/phase-08-eventing/domain-event-flow-contract.schema.json",
  "title": "Shared domain-event flow contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "profiles",
    "components",
    "channels",
    "rules",
    "excluded_flows"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "domain-event-flow.v1"},
    "contract_id": {"const": "domain-event-flow@1"},
    "profiles": {
      "const": ["six-layer-eventing@1"]
    },
    "components": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "responsibility", "presence"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^component\\."},
          "responsibility": {"type": "string", "minLength": 1},
          "presence": {"const": "mandatory"}
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "producer",
          "consumers",
          "payload_class",
          "ordering_key"
        ],
        "properties": {
          "channel_id": {"type": "string", "pattern": "^[a-z]+(?:\\.[a-z]+)*\\.v1$"},
          "producer": {"type": "string", "pattern": "^component\\."},
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^component\\."},
            "uniqueItems": true
          },
          "payload_class": {
            "enum": [
              "telemetry",
              "match",
              "notification",
              "device_command",
              "outcome"
            ]
          },
          "ordering_key": {"const": "source_id"}
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_presence",
        "invocation_condition",
        "terminal_outcomes",
        "consumer_idempotency_key"
      ],
      "properties": {
        "evaluation_presence": {"const": "always"},
        "invocation_condition": {"const": "typed_rule_match"},
        "terminal_outcomes": {"const": "one_per_action_workflow_and_command"},
        "consumer_idempotency_key": {"const": "event_id"}
      }
    },
    "excluded_flows": {
      "const": [
        "storage_object_payload_via_event_broker",
        "l4_to_l5_asynchronous_event_query",
        "arbitrary_wrapper_to_user_function_remote_call"
      ]
    }
  }
}
