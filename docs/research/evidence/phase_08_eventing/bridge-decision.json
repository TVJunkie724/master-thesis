{
  "$schema": "schemas/bridge-decision.schema.json",
  "schema_version": "bridge-decision.v1",
  "decision_id": "phase-08-cross-cloud-bridge@1",
  "status": "selected_documented_live_pending",
  "profile_ownership": [
    {
      "profile_id": "five-layer-baseline@1",
      "bridge_presence": "none",
      "owner": "immutable_historical_profile"
    },
    {
      "profile_id": "five-layer-baseline@2",
      "bridge_presence": "remote_responsibility_edges_only",
      "owner": "producing_five_layer_responsibility"
    },
    {
      "profile_id": "six-layer-eventing@1",
      "bridge_presence": "remote_event_routes_only",
      "owner": "eventing_responsibility"
    }
  ],
  "logical_shape": {
    "component_id": "component.cross-cloud-bridge-forwarder",
    "flow": [
      "producer_accepts_into_source_durable_outbox",
      "source_runtime_receives_from_local_broker",
      "source_runtime_validates_canonical_envelope_and_route",
      "source_runtime_obtains_short_lived_destination_credential",
      "source_runtime_publishes_to_destination_broker_data_plane",
      "source_runtime_waits_for_destination_durable_acceptance",
      "source_runtime_acknowledges_source_message"
    ],
    "architecture_boundary": "source_owned_forwarder_to_destination_broker_data_plane",
    "forbidden_boundaries": [
      "public_function_to_function_invocation",
      "public_ingestion_glue_endpoint",
      "shared_secret_or_long_lived_cloud_key",
      "destination_owned_pull_from_source"
    ],
    "destination_consumer_runtime_is_outside_bridge": true
  },
  "security_contract": {
    "transport_encryption": "TLS_1_2_or_newer_through_official_provider_SDKs_for_identity_exchange_and_destination_publish",
    "endpoint_validation": "resolve_the_region_pinned_provider_data_plane_endpoint_from_the_official_SDK; require_normal_certificate_and_hostname_validation; reject_redirects_custom_endpoint_overrides_and_unknown_DNS_suffixes",
    "provider_trigger_ingress": {
      "aws": "provider_managed_Lambda_event_source_mapping_has_no_public_bridge_URL",
      "azure": "provider_managed_Functions_trigger_has_no_public_bridge_URL",
      "gcp_small_medium": "IAM_authenticated_PubSub_push_URL_is_provider_internal_trigger_ingress_not_the_cross_cloud_destination_boundary",
      "gcp_large": "StreamingPull_worker_pool_has_no_load_balanced_URL; control_uses_the_same_IAM_authenticated_push_boundary"
    },
    "credential_storage": "memory_only; never_environment_file_database_log_DLQ_or_envelope",
    "credential_cache_lifetime": "discard_at_token_expiry_minus_300_seconds_or_after_3600_seconds_whichever_occurs_first; refresh_before_publish_when_less_than_300_seconds_remain",
    "trust_constraints": [
      "exact_issuer",
      "exact_bridge_only_audience",
      "exact_subject_or_single_workload_token_issuance_assignment",
      "exact_source_environment",
      "exact_destination_resource"
    ],
    "destination_authorization": "publish_only_permission_on_the_exact_destination_stream_topic_or_entity; no_management_plane_permission"
  },
  "envelope_contract": {
    "contract_id": "canonical-domain-event.v1",
    "encoding": "utf-8-json",
    "max_serialized_event_bytes": 98304,
    "current_scenario_max_serialized_event_bytes": 66560,
    "required_fields": [
      {"name": "schema_version", "type": "semantic_contract_version", "max_length": 32},
      {"name": "event_id", "type": "uuid", "max_length": 36},
      {"name": "event_type", "type": "closed_channel_id", "max_length": 128},
      {"name": "deployment_id", "type": "bounded_identifier", "max_length": 256},
      {"name": "source_id", "type": "bounded_identifier", "max_length": 128},
      {"name": "source_sequence", "type": "bounded_identifier", "max_length": 256},
      {"name": "occurred_at", "type": "rfc3339_utc", "max_length": 35},
      {"name": "correlation_id", "type": "uuid", "max_length": 36},
      {"name": "causation_id", "type": "uuid", "max_length": 36},
      {"name": "producer", "type": "closed_component_id", "max_length": 128},
      {"name": "payload", "type": "schema_bound_object", "max_length": 94208}
    ],
    "optional_fields": [],
    "routing_fields": [
      "event_type",
      "schema_version",
      "producer",
      "source_id"
    ],
    "event_type_registry": {
      "core_flow_contract_ref": "domain-event-flow@1#channels",
      "core_event_types": [
        "telemetry.received.v1",
        "telemetry.processed.v1",
        "event.matched.v1",
        "notification.requested.v1",
        "device.command.requested.v1",
        "extension.action.outcome.v1",
        "notification.workflow.outcome.v1",
        "device.command.outcome.v1"
      ],
      "profile_extension_contract_ref": "twin_projection.v1",
      "profile_extension_event_types": [
        "twin.state.upserted",
        "twin.model.upserted",
        "twin.relationship.upserted",
        "twin.relationship.deleted"
      ],
      "closed_union_rule": "only_core_and_profile_extension_event_types_are_allowed",
      "cost_scope_rule": "phase_8_8_scenario_costs_cover_core_event_types_only; projection_workload_and_route_costs_are_owned_by_phase_08_complete_service_bundles"
    },
    "forbidden_fields": [
      "cloud_credentials",
      "provider_resource_ids",
      "deployment_urls",
      "terraform_names",
      "raw_exception",
      "arbitrary_http_headers"
    ],
    "unknown_event_type_or_schema": "terminal_schema_rejection_to_source_bridge_dlq",
    "consumer_idempotency_key": ["event_id"]
  },
  "delivery_contract": {
    "delivery_guarantee": "at_least_once",
    "ordering_scope": "per_source_id_and_source_sequence",
    "producer_ack_boundary": "source_durable_outbox_acceptance",
    "bridge_ack_boundary": "destination_broker_durable_acceptance",
    "consumer_ack_boundary": "idempotent_domain_effect_and_outcome_or_checkpoint",
    "source_invocation_batching": {
      "aws": "up_to_10_records_from_one_channel_trigger",
      "azure": "up_to_10_records_from_one_channel_trigger",
      "gcp_small_medium": "one_pubsub_push_message_per_request",
      "gcp_large_telemetry": "streaming_pull_with_per_message_ack",
      "gcp_large_control": "one_pubsub_push_message_per_request"
    },
    "concurrency_rule": "records_for_one_source_id_are_published_serially_by_source_sequence; different_source_ids_may_progress_in_parallel",
    "destination_batch_rule": "never_mix_channels_or_source_ids; maximum_10_events_and_983040_serialized_bytes; AWS_telemetry_uses_single_PutRecord",
    "destination_acceptance_signals": [
      {
        "provider": "aws",
        "telemetry": "PutRecord returns ShardId and SequenceNumber",
        "control": "SNS FIFO Publish returns MessageId and SequenceNumber"
      },
      {
        "provider": "azure",
        "telemetry": "EventHubProducerClient send completes without error",
        "control": "ServiceBusSenderClient send completes without error"
      },
      {
        "provider": "gcp",
        "telemetry": "PubSub publish future returns message_id",
        "control": "PubSub publish future returns message_id"
      }
    ]
  },
  "validation_and_error_contract": {
    "validation_order": [
      "serialized_size_and_UTF8_JSON",
      "required_and_forbidden_fields",
      "closed_event_type_and_schema_version",
      "field_bounds_and_source_id_is_the_portable_ordering_key",
      "route_exists_and_source_destination_match",
      "obtain_or_refresh_destination_credential",
      "publish_and_validate_destination_acceptance"
    ],
    "retryable_failures": [
      "network_timeout_or_connection_reset",
      "destination_rate_limit_or_throttle",
      "destination_5xx_or_transient_provider_error",
      "identity_exchange_429_or_5xx"
    ],
    "terminal_message_failures": [
      "oversized_or_invalid_UTF8_JSON",
      "missing_or_forbidden_field",
      "unknown_event_type_or_schema_version",
      "invalid_partition_or_identifier_contract"
    ],
    "route_blocking_failures": [
      "TLS_certificate_hostname_or_endpoint_suffix_mismatch",
      "unknown_or_mismatched_route",
      "identity_exchange_4xx_claim_rejection",
      "destination_401_or_403_permission_failure"
    ],
    "route_blocking_behavior": "open_circuit_and_retry_without_ack_within_the_same_six_attempt_provider_budget; on_current_attempt_6_write_the_safe_source_bridge_failure_record_and_ack_only_after_its_acceptance; retain_the_provider_native_terminal_destination_as_fallback; require_operator_correction_and_explicit_redrive",
    "terminal_message_behavior": "write_safe_source_bridge_DLQ_record_and_ack_or_checkpoint_only_after_DLQ_acceptance",
    "retry_exhaustion_behavior": "write_safe_source_bridge_DLQ_record_on_current_attempt_6_for_transient_or_route_blocking_failure_and_ack_or_checkpoint_only_after_DLQ_acceptance; provider_native_terminal_destination_remains_the_fallback_when_the_trigger_does_not_expose_the_current_attempt_or_intercepts_delivery",
    "destination_acceptance_requirement": "provider_data_plane_success_identifier_or_successful_send_completion_from_destination_acceptance_signals",
    "maximum_delivery_attempts": 6
  },
  "failure_contract": {
    "maximum_delivery_attempts": 6,
    "terminal_attempt": 6,
    "provider_retry_realizations": [
      {
        "provider": "aws",
        "telemetry": "Lambda Kinesis MaximumRetryAttempts=5, BisectBatchOnFunctionError=true, ReportBatchItemFailures, and S3 full-record on-failure fallback because Kinesis records do not expose the current invocation attempt to the function",
        "control": "SQS FIFO maxReceiveCount=6 with ApproximateReceiveCount passed to the application-safe failure writer on attempt 6 and the native SQS DLQ retained as fallback"
      },
      {
        "provider": "azure",
        "telemetry": "Functions exponential retry, maxRetryCount=5, minimumInterval=1s, maximumInterval=32s, with the application-safe failure Event Hub written on current attempt 6 before checkpoint",
        "control": "Service Bus MaxDeliveryCount=6 with delivery_count interpreted as prior failed deliveries, application-safe failure queue on current attempt 6, and the native Service Bus DLQ retained as fallback"
      },
      {
        "provider": "gcp",
        "telemetry": "PubSub dead-letter maxDeliveryAttempts=6, minimumBackoff=1s, maximumBackoff=32s, with the application-safe failure topic used when deliveryAttempt 6 is visible and the provider dead-letter topic retained as fallback",
        "control": "PubSub dead-letter maxDeliveryAttempts=6, minimumBackoff=1s, maximumBackoff=32s, with the application-safe failure topic used when deliveryAttempt 6 is visible and the provider dead-letter topic retained as fallback"
      }
    ],
    "backpressure": {
      "rule": "stop_or_nack_source_progress_before_in_memory_overflow; never_drop",
      "max_in_memory_events_per_runtime": 1000,
      "circuit_breaker": "open_route_after_5_consecutive_destination_failures_for_30_seconds",
      "ordered_key_behavior": "a_failed_device_key_pauses_its_provider_ordering_unit; unrelated_partitions_continue; keys_sharing_an_AWS_or_Azure_partition_may_also_pause"
    },
    "dead_letter_record": {
      "owner": "source_bridge",
      "retention": "scenario_retention_hours",
      "required_metadata": [
        "full_safe_canonical_envelope",
        "source_provider",
        "destination_provider",
        "route_id",
        "attempt_count",
        "first_failure_at",
        "terminal_failure_at",
        "bounded_failure_code"
      ],
      "forbidden_metadata": [
        "credentials",
        "raw_exception",
        "provider_resource_ids",
        "arbitrary_headers"
      ]
    },
    "redrive": {
      "event_id": "preserve",
      "source_ordering_identity": "preserve_source_id_and_source_sequence",
      "replay_id": "new_uuid_in_payload",
      "replay_marker": "payload_replay_id_required",
      "audit_outcome": "required",
      "ordering_degradation_outcome": "required_when_later_same_key_events_were_released"
    }
  },
  "observability_and_lifecycle_contract": {
    "allowed_log_fields": [
      "bounded_event_id",
      "bounded_correlation_id",
      "event_type",
      "schema_version",
      "source_provider",
      "destination_provider",
      "route_id",
      "attempt_count",
      "bounded_failure_code",
      "latency_milliseconds",
      "occurred_at"
    ],
    "forbidden_log_fields": [
      "payload",
      "device_id",
      "twin_id",
      "source_id",
      "credentials_or_tokens",
      "provider_resource_ids",
      "deployment_URLs",
      "raw_exceptions",
      "arbitrary_headers"
    ],
    "metric_names": [
      "bridge_source_lag",
      "bridge_publish_attempts",
      "bridge_publish_accepted",
      "bridge_retries",
      "bridge_dlq_writes",
      "bridge_route_blocked",
      "bridge_circuit_open",
      "bridge_end_to_end_latency",
      "bridge_ordering_degraded"
    ],
    "metric_dimensions": [
      "source_provider",
      "destination_provider",
      "route_id",
      "channel_id",
      "scenario_id"
    ],
    "forbidden_metric_dimensions": [
      "event_id",
      "correlation_id",
      "source_id",
      "device_id",
      "twin_id",
      "credential_subject"
    ],
    "audit_events": [
      "route_configuration_activated",
      "identity_claim_set_live_verified",
      "route_blocked_or_unblocked",
      "terminal_message_rejected",
      "DLQ_redrive_started_and_completed",
      "ordering_degradation_recorded"
    ],
    "retention": {
      "source_outbox_and_bridge_DLQ": "scenario_retention_hours",
      "operational_logs_and_audit": "30_days",
      "in_memory_envelope": "discard_immediately_after_source_ack_or_terminal_DLQ_acceptance",
      "credential": "discard_at_credential_cache_lifetime_boundary_and_runtime_shutdown"
    },
    "deletion_rule": "provider_retention_or_explicit_cleanup_deletes_messages_logs_audit_and_DLQ_records; redrive_never_extends_retention_silently"
  },
