{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "functional-matrix.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "package_id", "evaluation_order", "profile_rows", "provider_bundles", "comparison_boundary"],
  "properties": {
    "$schema": {"const": "schemas/functional-matrix.schema.json"},
    "schema_version": {"const": "phase-08-functional-matrix.v1"},
    "package_id": {"const": "phase-08-profile-evaluation@1"},
    "evaluation_order": {"const": ["functional_completeness", "theoretical_capacity", "estimated_cost"]},
    "profile_rows": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profile_id", "role", "status", "domain_capabilities", "event_layer_capabilities", "event_responsibility", "ranked_with_profile_ids"],
        "properties": {
          "profile_id": {"enum": ["five-layer-baseline@1", "five-layer-baseline@2", "six-layer-eventing@1"]},
          "role": {"enum": ["historical_reconstruction", "functionally_aligned_control", "functionally_aligned_treatment"]},
          "status": {"enum": ["historical", "supported"]},
          "domain_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "event_layer_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "event_responsibility": {"type": "string", "minLength": 1},
          "ranked_with_profile_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "provider_bundles": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profile_id", "provider", "status", "services", "present_capabilities", "missing_capabilities", "extra_capabilities", "functional_evaluation_status", "live_verification_status"],
        "properties": {
          "profile_id": {"enum": ["five-layer-baseline@2", "six-layer-eventing@1"]},
          "provider": {"enum": ["aws", "azure", "gcp"]},
          "status": {"const": "supported"},
          "services": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "present_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "missing_capabilities": {"type": "array", "maxItems": 0},
          "extra_capabilities": {"type": "array", "maxItems": 0},
          "functional_evaluation_status": {"const": "functionally_complete_before_cost"},
          "live_verification_status": {"const": "pending_supervised_run"}
        }
      }
    },
    "comparison_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["functional_parity_profiles", "historical_profile_ranked_with_active_profiles", "cross_profile_optimizer_winner", "cost_interpretation"],
      "properties": {
        "functional_parity_profiles": {"const": ["five-layer-baseline@2", "six-layer-eventing@1"]},
        "historical_profile_ranked_with_active_profiles": {"const": false},
        "cross_profile_optimizer_winner": {"const": false},
        "cost_interpretation": {"const": "profile_local_only_then_matched_context_delta"}
      }
    }
  }
}
