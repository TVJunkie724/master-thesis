{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "verification.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "package_id", "evidence_timestamp", "artifact_digests", "artifact_set_digest", "commands", "cloud_activity"],
  "properties": {
    "$schema": {"const": "schemas/verification.schema.json"}, "schema_version": {"const": "phase-08-profile-evaluation-verification.v1"},
    "package_id": {"const": "phase-08-profile-evaluation@1"}, "evidence_timestamp": {"type": "string", "format": "date"},
    "artifact_digests": {
      "type": "array", "minItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "not": {"pattern": "^/"}}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
    },
    "artifact_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commands": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["command_id", "command", "status", "exit_status", "test_count", "scope"],
        "properties": {"command_id": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "status": {"const": "passed"}, "exit_status": {"const": 0}, "test_count": {"type": "integer", "minimum": 0}, "scope": {"type": "string", "minLength": 1}}
      }
    },
    "cloud_activity": {
      "type": "object", "additionalProperties": false, "required": ["provider_credentials_used", "terraform_apply_or_destroy", "provider_resource_created", "browser_sign_in", "paid_operation"],
      "properties": {"provider_credentials_used": {"const": false}, "terraform_apply_or_destroy": {"const": false}, "provider_resource_created": {"const": false}, "browser_sign_in": {"const": false}, "paid_operation": {"const": false}}
    }
  }
}
