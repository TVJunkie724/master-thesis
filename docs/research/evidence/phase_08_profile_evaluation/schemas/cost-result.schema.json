{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cost-result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "profile_id", "scenario_id", "size", "currency", "comparison_scope", "optimizer_result", "online_placement_results", "directed_event_pair_results", "representative_three_provider_result", "interpretation"],
  "properties": {
    "$schema": {"const": "../schemas/cost-result.schema.json"},
    "schema_version": {"const": "phase-08-profile-cost-result.v1"},
    "profile_id": {"enum": ["five-layer-baseline@2", "six-layer-eventing@1"]},
    "scenario_id": {"type": "string", "pattern": "^profile-evaluation-(small|medium|large)-v1$"},
    "size": {"enum": ["small", "medium", "large"]},
    "currency": {"const": "USD"},
    "comparison_scope": {"const": "profile_local"},
    "optimizer_result": {
      "type": "object", "additionalProperties": false,
      "required": ["enumerated_candidate_count", "costed_candidate_count", "rejected_by_error_code", "winner"],
      "properties": {
        "enumerated_candidate_count": {"type": "integer", "minimum": 1},
        "costed_candidate_count": {"type": "integer", "minimum": 1},
        "rejected_by_error_code": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "winner": {"$ref": "#/$defs/candidate"}
      }
    },
    "online_placement_results": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/candidate"}},
    "directed_event_pair_results": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/candidate"}},
    "representative_three_provider_result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate"}]},
    "interpretation": {
      "type": "object", "additionalProperties": false,
      "required": ["estimated_operational_cost_only", "profile_local_ranking_only", "measured_invoice_or_throughput", "shared_resource_allocation_policy", "same_provider_bridge_policy"],
      "properties": {
        "estimated_operational_cost_only": {"const": true},
        "profile_local_ranking_only": {"const": true},
        "measured_invoice_or_throughput": {"const": false},
        "shared_resource_allocation_policy": {"const": "fixed_shared_resources_charged_once_to_declared_cost_owner_without_consumer_apportionment"},
        "same_provider_bridge_policy": {"const": "cross_cloud_bridge_and_egress_zero_when_source_equals_destination"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "amount": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "assignment": {"type": "object", "minProperties": 7, "additionalProperties": {"enum": ["aws", "azure", "gcp"]}},
    "contribution": {
      "type": "object", "additionalProperties": false,
      "required": ["contribution_id", "kind", "provider", "logical_component_id", "category", "monthly_amount", "cost_owner_id"],
      "properties": {
        "contribution_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["component", "route"]},
        "provider": {"enum": ["aws", "azure", "gcp"]}, "logical_component_id": {"type": ["string", "null"]},
        "category": {"enum": ["service", "request-throughput", "storage", "transfer", "tiering", "observability", "failure-replay", "visualization-seat", "bridge"]},
        "monthly_amount": {"$ref": "#/$defs/amount"}, "cost_owner_id": {"type": "string", "minLength": 1}
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["monthly_total", "category_totals", "event_transport_scope_total", "independent_event_layer_total", "contributions", "exact_once_owner_count"],
      "properties": {
        "monthly_total": {"$ref": "#/$defs/amount"},
        "category_totals": {
          "type": "object", "additionalProperties": false,
          "required": ["service", "request-throughput", "storage", "transfer", "tiering", "observability", "failure-replay", "visualization-seat", "bridge"],
          "properties": {
            "service": {"$ref": "#/$defs/amount"}, "request-throughput": {"$ref": "#/$defs/amount"},
            "storage": {"$ref": "#/$defs/amount"}, "transfer": {"$ref": "#/$defs/amount"},
            "tiering": {"$ref": "#/$defs/amount"}, "observability": {"$ref": "#/$defs/amount"},
            "failure-replay": {"$ref": "#/$defs/amount"}, "visualization-seat": {"$ref": "#/$defs/amount"},
            "bridge": {"$ref": "#/$defs/amount"}
          }
        },
        "event_transport_scope_total": {"$ref": "#/$defs/amount"},
        "independent_event_layer_total": {"$ref": "#/$defs/amount"},
        "contributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contribution"}},
        "exact_once_owner_count": {"type": "integer", "minimum": 1}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "assignment", "status", "functional_status", "capacity_status", "live_verification_status", "blocking_live_gate_ids", "resolved_deployment_specification_digest", "cost"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "assignment": {"$ref": "#/$defs/assignment"},
        "status": {"const": "supported_offline_estimate"}, "functional_status": {"const": "complete"},
        "capacity_status": {"const": "theoretical_pass_live_pending"}, "live_verification_status": {"const": "pending_supervised_run"},
        "blocking_live_gate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "resolved_architecture_path": {"type": "string", "not": {"pattern": "^/"}},
        "resolved_twin_architecture_digest": {"$ref": "#/$defs/digest"},
        "resolved_deployment_specification_digest": {"$ref": "#/$defs/digest"},
        "cost": {"$ref": "#/$defs/cost"},
        "placement_id": {"type": "string", "minLength": 1},
        "placement_class": {"enum": ["single_cloud", "l3l5_local_l4_remote"]},
        "directed_pair": {"type": "string", "pattern": "^(aws|azure|gcp)->(aws|azure|gcp)$"},
        "pair_semantics": {"type": "string", "minLength": 1}
      }
    }
  }
}
